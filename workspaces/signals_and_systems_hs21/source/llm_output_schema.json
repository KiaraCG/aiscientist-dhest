{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMExamSubmission",
  "type": "object",
  "properties": {
    "examId": { "type": "string" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "answer"],
        "properties": {
          "id": { "type": "string", "description": "Matches question ID" },
          "answer": {
            "description": "Can be a string (single-choice, free-text), number, or array of strings (multiple-choice)."
          }
        }
      }
    }
  },
  "required": ["examId", "answers"]
}