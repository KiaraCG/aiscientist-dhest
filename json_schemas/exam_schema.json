{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamPrompt",
  "type": "object",
  "properties": {
    "examId": { "type": "string" },
    "title": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "points"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "points": { "type": "number", "minimum": 0 },
          "type": { "type": "string", "enum": ["free-text", "number", "single-choice", "multiple-choice"] },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required for single-choice and multiple-choice questions"
          }
        }
      }
    }
  },
  "required": ["examId", "title", "questions"]
}