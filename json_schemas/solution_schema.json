{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExamSolutionKey",
  "type": "object",
  "patternProperties": {
    "^q[0-9]+$": {
      "type": "object",
      "required": ["type", "points"],
      "properties": {
        "type": { "type": "string", "enum": ["free-text", "number", "single-choice", "multiple-choice"] },
        "points": { "type": "number", "minimum": 0 },
        "correctAnswer": {
          "description": "Used for single-choice and number types"
        },
        "correctAnswers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Used for multiple-choice type"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Optional acceptable margin for number types"
        },
        "sampleAnswer": {
          "type": "string",
          "description": "Reference rubric for free-text evaluation"
        }
      }
    }
  },
  "additionalProperties": false
}